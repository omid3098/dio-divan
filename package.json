{
  "name": "dio-divan",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Omid Saadat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omid3098/dio-divan.git"
  },
  "homepage": "https://github.com/omid3098/dio-divan#readme",
  "bugs": {
    "url": "https://github.com/omid3098/dio-divan/issues"
  },
  "type": "module",
  "description": "Build AI workflows from coding assistants and use each workflow as one model.",
  "packageManager": "pnpm@11.28.4",
  "engines": {
    "node": ">=24.21.0"
  },
  "bin": {
    "divan": "bin/dio-divan.mjs"
  },
  "scripts": {
    "start": "node bin/dio-divan.mjs",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.release.json && node scripts/hermes-assets.mjs && vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "e2e": "node e2e/run.mjs && node e2e/layout.mjs",
    "e2e:pi": "node e2e/pi-provider.mjs",
    "e2e:screens": "node e2e/screens.mjs",
    "e2e:flows": "node e2e/flows-screens.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^1.8.0",
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright-core": "^1.64.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "@base-ui/react": "^1.9.0",
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.54.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0"
  },
  "files": [
    "bin/",
    "dist/server/",
    "dist/shared/",
    "dist/web/",
    "schemas/",
    "pi-extension/",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ]
}
